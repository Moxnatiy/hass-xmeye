  "services": {
    "ptz": {
      "name": "PTZ control",
      "description": "Move a PTZ camera or jump to a preset.",
      "fields": {
        "config_entry_id": { "name": "Recorder", "description": "Which recorder to talk to." },
        "direction": { "name": "Direction", "description": "Movement or lens command." },
        "channel": { "name": "Channel", "description": "Channel number, counted from 0." },
        "speed": { "name": "Speed", "description": "Step size, 1 to 8." },
        "duration": { "name": "Duration", "description": "How long to move, in seconds." },
        "preset": { "name": "Preset", "description": "Go to this preset instead of moving." }
      }
    },
    "search_recordings": {
      "name": "Search recordings",
      "description": "List archive recordings for a channel and time range.",
      "fields": {
        "config_entry_id": { "name": "Recorder", "description": "Which recorder to query." },
        "channel": { "name": "Channel", "description": "Channel number, counted from 0." },
        "start": { "name": "Start", "description": "Beginning of the range." },
        "end": { "name": "End", "description": "End of the range." },
        "event": { "name": "Event", "description": "* all, M motion, A alarm, R schedule, H manual." }
      }
    },
    "download_recording": {
      "name": "Download recording",
      "description": "Download a recording into the media folder as an elementary stream.",
      "fields": {
        "config_entry_id": { "name": "Recorder", "description": "Which recorder to query." },
        "filename": { "name": "File name", "description": "Name returned by Search recordings." },
        "start": { "name": "Start", "description": "Recording start time." },
        "end": { "name": "End", "description": "Recording end time." },
        "channel": { "name": "Channel", "description": "Channel number, counted from 0." }
      }
    },
    "get_config": {
      "name": "Read configuration",
      "description": "Read one configuration section from the recorder.",
      "fields": {
        "config_entry_id": { "name": "Recorder", "description": "Which recorder to query." },
        "section": { "name": "Section", "description": "For example NetWork.NetCommon." }
      }
    },
    "set_config": {
      "name": "Write configuration",
      "description": "Write one configuration section back to the recorder.",
      "fields": {
        "config_entry_id": { "name": "Recorder", "description": "Which recorder to change." },
        "section": { "name": "Section", "description": "For example General.Location." },
        "value": { "name": "Value", "description": "Full section content." }
      }
    },
    "talk": {
      "name": "Play audio",
      "description": "Send G.711 audio to the recorder's speaker.",
      "fields": {
        "config_entry_id": { "name": "Recorder", "description": "Which recorder to talk to." },
        "audio_file": { "name": "Audio file", "description": "Path to raw G.711 A-law audio." }
      }
    }
  }
